# Gemini — "upper reference" model and the labeler used to build the training set.
# Free-tier key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Fine-tuned model served behind any OpenAI-compatible /chat/completions endpoint
# (HF Inference Endpoint, a Space running llama.cpp/vLLM, ...). The URL includes /v1.
# FINETUNED_API_URL=https://YOUR-ENDPOINT.endpoints.huggingface.cloud/v1
# FINETUNED_MODEL=drin-tech-tools/job-extractor-qwen2.5-1.5b-lora
# Same for the un-tuned base model (the baseline in the eval table).
# BASE_API_URL=https://router.huggingface.co/v1
# BASE_MODEL=Qwen/Qwen2.5-1.5B-Instruct
# HF_TOKEN=hf_...

# Optional shared secret. When set, every request must include matching
# X-Internal-Api-Token (the Next.js BFF sends INTERNAL_API_TOKEN).
# INTERNAL_API_TOKEN=

# CORS is unused in production (API is internal-only). Harmless for local
# browser→API access (e.g. http://localhost:8000/docs).
ALLOWED_ORIGINS=http://localhost:3000

# Optional — pin a Gemini model; otherwise ordered fallback is used
# GEMINI_MODEL=gemini-flash-latest

# Deterministic heuristic extractor for local demos / CI (no Gemini, no HF endpoint)
# EXTRACTOR_MOCK=1

# Guardrail tuning (optional)
# REQUEST_TIMEOUT_S=60
